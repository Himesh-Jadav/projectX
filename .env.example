# Host port for Docker; change if 3003 is already in use.
HOST_PORT=3003
APP_URL_DOCKER=http://localhost:3003
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
DEMO_PASSWORD=replace-with-a-demo-only-password
APP_URL=http://localhost:5173
GROQ_API_KEYS=
GEMINI_API_KEYS=your-gemini-key
OPENROUTER_API_KEYS=
FAST_MODEL=openai/gpt-oss-20b
SMART_MODEL=openai/gpt-oss-120b
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_SMART_MODEL=gemini-3.8-flash
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
